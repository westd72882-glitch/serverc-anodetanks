# Copy this to .env for local development. On Render, set these as
# Environment Variables in the service's dashboard instead of a file --
# never commit a real .env with real secrets to git.

# Render's managed Postgres gives you this connection string directly on
# the database's page (the "Internal Database URL" if your web service is
# in the same region, or "External Database URL" otherwise).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Any long random string -- used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates every currently-logged-in client's token
# (they'll just need to log in again -- not destructive to their data).
JWT_SECRET=change-me-to-a-long-random-string

# Render sets PORT for you automatically in production; this default is
# only used when running locally.
PORT=3000

# Full public URL of this same service, used by the self-ping in
# src/keepAlive.ts to stop Render's free tier from sleeping the instance.
# On Render this is your service's URL, e.g. https://your-app.onrender.com
# Leave blank to disable self-ping (e.g. for local dev).
SELF_URL=
